; problems/tictactoe.aura — h x v tic-tac-toe, k in a row (aima-python TicTacToe).
; State = (vector to-move utility board moves); board is a vector indexed
; (x-1)*v + (y-1) holding 'X, 'O or #f; moves is a list of (x . y) built with cons
; (quoted dotted literals are mis-read, #4487). Utility is cached on the state:
; +1 if X just won, -1 if O just won, else 0.
(require "aima/games" all:)
(export make-tictactoe ttt-state ttt-board-ref ttt-moves ttt-initial-moves)

(define (ttt-moves s) (vector-ref s 3))

(define (ttt-initial-moves h v)
  (let lx ((x h) (acc '()))
    (if (< x 1) acc
        (lx (- x 1) (let ly ((y v) (acc acc)) (if (< y 1) acc (ly (- y 1) (cons (cons x y) acc))))))))

(define (remove-move m ms)
  (cond ((null? ms) '()) ((equal? (car ms) m) (cdr ms)) (else (cons (car ms) (remove-move m (cdr ms))))))
(define (has-move? m ms) (cond ((null? ms) #f) ((equal? (car ms) m) #t) (else (has-move? m (cdr ms)))))

(define (make-tictactoe h v k)
  (define (idx x y) (+ (* (- x 1) v) (- y 1)))
  (define (bref b x y) (if (and (>= x 1) (<= x h) (>= y 1) (<= y v)) (vector-ref b (idx x y)) #f))
  (define (run b x y dx dy p)
    (let lp ((x x) (y y) (n 0)) (if (eq? (bref b x y) p) (lp (+ x dx) (+ y dy) (+ n 1)) n)))
  (define (k-in-row? b m p dx dy)
    (>= (- (+ (run b (car m) (cdr m) dx dy p) (run b (car m) (cdr m) (- dx) (- dy) p)) 1) k))
  (define (compute-utility b m p)
    (if (or (k-in-row? b m p 0 1) (k-in-row? b m p 1 0) (k-in-row? b m p 1 -1) (k-in-row? b m p 1 1))
        (if (eq? p 'X) 1 -1)
        0))
  (define (result s m)
    (if (not (has-move? m (vector-ref s 3))) s
        (let ((b (list->vector (vector->list (vector-ref s 2)))) (p (vector-ref s 0)))
          (vector-set! b (idx (car m) (cdr m)) p)
          (vector (if (eq? p 'X) 'O 'X) (compute-utility b m p) b (remove-move m (vector-ref s 3))))))
  (make-game (vector 'X 0 (make-vector (* h v) #f) (ttt-initial-moves h v))
             (lambda (s) (vector-ref s 3))
             result
             (lambda (s p) (if (eq? p 'X) (vector-ref s 1) (- (vector-ref s 1))))
             (lambda (s) (or (not (= (vector-ref s 1) 0)) (null? (vector-ref s 3))))
             (lambda (s) (vector-ref s 0))))

; ttt-state: like aima's test gen_state on a 3x3 board, with row-major move order.
(define (ttt-state to-move xs os)
  (let ((b (make-vector 9 #f)))
    (for-each (lambda (m) (vector-set! b (+ (* (- (car m) 1) 3) (- (cdr m) 1)) 'X)) xs)
    (for-each (lambda (m) (vector-set! b (+ (* (- (car m) 1) 3) (- (cdr m) 1)) 'O)) os)
    (vector to-move 0 b
            (let lp ((ms (ttt-initial-moves 3 3)) (acc '()))
              (cond ((null? ms) (reverse acc))
                    ((or (has-move? (car ms) xs) (has-move? (car ms) os)) (lp (cdr ms) acc))
                    (else (lp (cdr ms) (cons (car ms) acc))))))))

(define (ttt-board-ref s x y) (vector-ref (vector-ref s 2) (+ (* (- x 1) 3) (- y 1))))
