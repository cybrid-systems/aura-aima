; problems/graph.aura — GraphProblem over an undirected weighted graph, plus the
; Romania and Australia maps of AIMA Fig. 3.1 / 6.1.
; Map data transcribed from the book (and checked against aima-python search.py).
; Neighbour order equals aima-python's UndirectedGraph dict order, so tie-breaking
; (and therefore DFS paths and expansion counts) matches.
(require "aima/search" all:)
(require "aima/list" all:)
(export romania-map romania-locations australia-map graph-neighbors graph-distance
        make-graph-problem sym-assq)

; assq is not an Aura primitive (only assv) — tiny local version on eq?.
(define (sym-assq k al)
  (cond ((null? al) #f) ((eq? (car (car al)) k) (car al)) (else (sym-assq k (cdr al)))))

; graph = alist: city -> list of (neighbor distance).
; Proper 2-lists, not dotted pairs: a quoted dotted pair holding a symbol, e.g.
; '(Zerind . 75), reads as a circular (cons Zerind Zerind ...) list in Aura
; 9058d36c4 (see IMPROVEMENTS.md / STATE.txt).
(define romania-map
  '((Arad (Zerind 75) (Sibiu 140) (Timisoara 118))
    (Bucharest (Urziceni 85) (Pitesti 101) (Giurgiu 90) (Fagaras 211))
    (Craiova (Drobeta 120) (Rimnicu 146) (Pitesti 138))
    (Drobeta (Mehadia 75) (Craiova 120))
    (Eforie (Hirsova 86))
    (Fagaras (Sibiu 99) (Bucharest 211))
    (Hirsova (Urziceni 98) (Eforie 86))
    (Iasi (Vaslui 92) (Neamt 87))
    (Lugoj (Timisoara 111) (Mehadia 70))
    (Oradea (Zerind 71) (Sibiu 151))
    (Pitesti (Rimnicu 97) (Bucharest 101) (Craiova 138))
    (Rimnicu (Sibiu 80) (Craiova 146) (Pitesti 97))
    (Urziceni (Vaslui 142) (Bucharest 85) (Hirsova 98))
    (Zerind (Arad 75) (Oradea 71))
    (Sibiu (Arad 140) (Fagaras 99) (Oradea 151) (Rimnicu 80))
    (Timisoara (Arad 118) (Lugoj 111))
    (Giurgiu (Bucharest 90))
    (Mehadia (Drobeta 75) (Lugoj 70))
    (Vaslui (Iasi 92) (Urziceni 142))
    (Neamt (Iasi 87))))

; Map coordinates used for the straight-line-distance heuristic.
(define romania-locations
  '((Arad 91 492) (Bucharest 400 327) (Craiova 253 288) (Drobeta 165 299)
    (Eforie 562 293) (Fagaras 305 449) (Giurgiu 375 270) (Hirsova 534 350)
    (Iasi 473 506) (Lugoj 165 379) (Mehadia 168 339) (Neamt 406 537)
    (Oradea 131 571) (Pitesti 320 368) (Rimnicu 233 410) (Sibiu 207 457)
    (Timisoara 94 410) (Urziceni 456 350) (Vaslui 509 444) (Zerind 108 531)))

(define australia-map
  '((T)
    (SA (WA 1) (NT 1) (Q 1) (NSW 1) (V 1))
    (NT (WA 1) (Q 1) (SA 1))
    (NSW (Q 1) (V 1) (SA 1))
    (WA (SA 1) (NT 1))
    (Q (SA 1) (NT 1) (NSW 1))
    (V (SA 1) (NSW 1))))

(define (graph-neighbors g a) (let ((e (sym-assq a g))) (if e (cdr e) '())))
(define (graph-distance g a b)
  (let ((e (sym-assq b (graph-neighbors g a)))) (if e (cadr e) #f)))

; h = int(euclidean distance), like GraphProblem.h; 0 when no locations.
(define (sld locs a b)
  (let ((pa (sym-assq a locs)) (pb (sym-assq b locs)))
    (if (and pa pb)
        (let ((dx (- (cadr pa) (cadr pb))) (dy (- (car (cddr pa)) (car (cddr pb)))))
          ; exact->inexact is unbound in Soft (see STATE.txt), so (* 1.0 n)
          (inexact->exact (floor (sqrt (* 1.0 (+ (* dx dx) (* dy dy)))))))
        0)))

(define (make-graph-problem initial goal g locs)
  (make-problem initial
                (lambda (s) (eq? s goal))
                (lambda (s) (lmap car (graph-neighbors g s)))
                (lambda (s a) a)
                (lambda (c s a s2) (+ c (graph-distance g s s2)))
                (lambda (s) (sld locs s goal))))
