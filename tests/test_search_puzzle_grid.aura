;; Pairs are built with cons: quoted dotted literals are mis-read (see STATE.txt).
;; Ch3 search on the 8-puzzle and a 5x5 grid: solutions + counters vs aima-python.
(require "aima/check" all:)
(require "aima/search" all:)
(require "problems/eight-puzzle" all:)
(require "problems/grid" all:)

(define (run name n p sol cost succs gt states)
  (check-equal (string-append name " solution") (if n (node-solution n) #f) sol)
  (check-equal (string-append name " cost") (if n (node-cost n) #f) cost)
  (check-equal (string-append name " counters") (list (search-succs p) (search-goal-tests p) (search-states p)) (list succs gt states)))
(define p (make-eight-puzzle (vector 2 4 3 1 5 6 7 8 0)))
(run "8p 243156780 bfs-graph" (breadth-first-graph-search p puzzle-key) p '(UP LEFT UP LEFT DOWN RIGHT RIGHT DOWN) 8 104 179 286)
(define p (make-eight-puzzle (vector 2 4 3 1 5 6 7 8 0)))
(run "8p 243156780 ucs" (uniform-cost-search p puzzle-key) p '(UP LEFT UP LEFT DOWN RIGHT RIGHT DOWN) 8 178 179 496)
(define p (make-eight-puzzle (vector 2 4 3 1 5 6 7 8 0)))
(run "8p 243156780 astar" (astar-search p puzzle-key) p '(UP LEFT UP LEFT DOWN RIGHT RIGHT DOWN) 8 22 23 64)
(define p (make-eight-puzzle (vector 1 2 3 4 5 7 8 6 0)))
(run "8p 123457860 astar" (astar-search p puzzle-key) p '(LEFT LEFT UP RIGHT RIGHT DOWN LEFT UP LEFT DOWN RIGHT RIGHT) 12 114 115 306)
(define p (make-eight-puzzle (vector 1 2 3 4 5 6 0 7 8)))
(run "8p 123456078 bfs-graph" (breadth-first-graph-search p puzzle-key) p '(RIGHT RIGHT) 2 3 7 8)
(define p (make-eight-puzzle (vector 1 2 3 4 5 6 0 7 8)))
(run "8p 123456078 ucs" (uniform-cost-search p puzzle-key) p '(RIGHT RIGHT) 2 6 7 18)
(define p (make-eight-puzzle (vector 1 2 3 4 5 6 0 7 8)))
(run "8p 123456078 astar" (astar-search p puzzle-key) p '(RIGHT RIGHT) 2 2 3 5)
(check-true "solvable" (puzzle-solvable? (vector 2 4 3 1 5 6 7 8 0)))
(check-true "unsolvable" (not (puzzle-solvable? (vector 2 1 3 4 5 6 7 8 0))))
(define p (make-grid-problem (cons 0 0) (cons 4 0) 5 5 (list (cons 2 0) (cons 2 1) (cons 2 2) (cons 2 3))))
(define n (breadth-first-graph-search p grid-key))
(check-equal "grid (4, 0) bfs-graph path" (node-path-states n) (list (cons 0 0) (cons 0 1) (cons 0 2) (cons 0 3) (cons 0 4) (cons 1 4) (cons 2 4) (cons 3 4) (cons 4 4) (cons 4 3) (cons 4 2) (cons 4 1) (cons 4 0)))
(check-equal "grid (4, 0) bfs-graph cost/counters" (list (node-cost n) (search-succs p) (search-goal-tests p) (search-states p)) (list 12 19 21 52))
(define p (make-grid-problem (cons 0 0) (cons 4 0) 5 5 (list (cons 2 0) (cons 2 1) (cons 2 2) (cons 2 3))))
(define n (depth-first-graph-search p grid-key))
(check-equal "grid (4, 0) dfs-graph path" (node-path-states n) (list (cons 0 0) (cons 1 0) (cons 1 1) (cons 1 2) (cons 1 3) (cons 1 4) (cons 2 4) (cons 3 4) (cons 3 3) (cons 3 2) (cons 3 1) (cons 3 0) (cons 4 0)))
(check-equal "grid (4, 0) dfs-graph cost/counters" (list (node-cost n) (search-succs p) (search-goal-tests p) (search-states p)) (list 12 12 13 32))
(define p (make-grid-problem (cons 0 0) (cons 4 0) 5 5 (list (cons 2 0) (cons 2 1) (cons 2 2) (cons 2 3))))
(define n (uniform-cost-search p grid-key))
(check-equal "grid (4, 0) ucs path" (node-path-states n) (list (cons 0 0) (cons 0 1) (cons 0 2) (cons 0 3) (cons 0 4) (cons 1 4) (cons 2 4) (cons 3 4) (cons 4 4) (cons 4 3) (cons 4 2) (cons 4 1) (cons 4 0)))
(check-equal "grid (4, 0) ucs cost/counters" (list (node-cost n) (search-succs p) (search-goal-tests p) (search-states p)) (list 12 20 21 54))
(define p (make-grid-problem (cons 0 0) (cons 4 0) 5 5 (list (cons 2 0) (cons 2 1) (cons 2 2) (cons 2 3))))
(define n (astar-search p grid-key))
(check-equal "grid (4, 0) astar path" (node-path-states n) (list (cons 0 0) (cons 1 0) (cons 1 1) (cons 1 2) (cons 1 3) (cons 1 4) (cons 2 4) (cons 3 4) (cons 4 4) (cons 4 3) (cons 4 2) (cons 4 1) (cons 4 0)))
(check-equal "grid (4, 0) astar cost/counters" (list (node-cost n) (search-succs p) (search-goal-tests p) (search-states p)) (list 12 20 21 54))
(define p (make-grid-problem (cons 0 0) (cons 4 4) 5 5 (list (cons 3 4) (cons 4 3))))
(define n (breadth-first-graph-search p grid-key))
(check-equal "grid (4, 4) bfs-graph unreachable" n #f)
(check-equal "grid (4, 4) bfs-graph counters" (list (search-succs p) (search-goal-tests p) (search-states p)) (list 22 22 68))
(define p (make-grid-problem (cons 0 0) (cons 4 4) 5 5 (list (cons 3 4) (cons 4 3))))
(define n (depth-first-graph-search p grid-key))
(check-equal "grid (4, 4) dfs-graph unreachable" n #f)
(check-equal "grid (4, 4) dfs-graph counters" (list (search-succs p) (search-goal-tests p) (search-states p)) (list 22 22 68))
(define p (make-grid-problem (cons 0 0) (cons 4 4) 5 5 (list (cons 3 4) (cons 4 3))))
(define n (uniform-cost-search p grid-key))
(check-equal "grid (4, 4) ucs unreachable" n #f)
(check-equal "grid (4, 4) ucs counters" (list (search-succs p) (search-goal-tests p) (search-states p)) (list 22 22 68))
(define p (make-grid-problem (cons 0 0) (cons 4 4) 5 5 (list (cons 3 4) (cons 4 3))))
(define n (astar-search p grid-key))
(check-equal "grid (4, 4) astar unreachable" n #f)
(check-equal "grid (4, 4) astar counters" (list (search-succs p) (search-goal-tests p) (search-states p)) (list 22 22 68))
