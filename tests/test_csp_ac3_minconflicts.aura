;; Ch6 CSP: AC-3 fixpoint domains and min-conflicts (seeded LCG) on Australia / n-queens.
(require "aima/check" all:)
(require "aima/csp" all:)
(require "problems/map-coloring" all:)

(define (aus) (make-map-coloring-csp (list (quote R) (quote G) (quote B)) australia-spec))
(define (idx c r) (region-index c r))
(define (pre c regs cols) (if (null? regs) #t (begin (csp-set-domain! c (idx c (car regs)) (list (car cols))) (pre c (cdr regs) (cdr cols)))))
(define (sym-sort xs) (let ((order (list (quote B) (quote G) (quote R)))) (let lp ((o order) (acc (list))) (if (null? o) (reverse acc) (lp (cdr o) (if (member (car o) xs) (cons (car o) acc) acc))))))
(define (domains c) (map sym-sort (vector->list (csp-curr-domains c))))
(define c (aus))
(check-true "ac3 plain consistent" (ac3 c))
(check-equal "ac3 plain domains" (domains c) (list (list (quote B) (quote G) (quote R)) (list (quote B) (quote G) (quote R)) (list (quote B) (quote G) (quote R)) (list (quote B) (quote G) (quote R)) (list (quote B) (quote G) (quote R)) (list (quote B) (quote G) (quote R))))
(define c (aus))
(pre c (list (quote WA) (quote SA)) (list (quote R) (quote G)))
(check-true "ac3 WA=R,SA=G consistent" (ac3 c))
(check-equal "ac3 WA=R,SA=G domains" (domains c) (list (list (quote G)) (list (quote R)) (list (quote B)) (list (quote R)) (list (quote B)) (list (quote R))))
(define c (aus))
(pre c (list (quote WA) (quote NT) (quote Q)) (list (quote R) (quote G) (quote R)))
(check-true "ac3 WA=R,NT=G,Q=R consistent" (ac3 c))
(check-equal "ac3 WA=R,NT=G,Q=R domains" (domains c) (list (list (quote B)) (list (quote R)) (list (quote G)) (list (quote R)) (list (quote G)) (list (quote R))))
(define c (aus))
(pre c (list (quote WA) (quote NT)) (list (quote R) (quote R)))
(check-true "ac3 WA=NT=R inconsistent" (not (ac3 c)))
(define c (make-map-coloring-csp (list (quote R) (quote G)) (list (list (quote A) (quote B) (quote C)) (list (quote B) (quote C)))))
(check-true "ac3 cannot see 2-colour triangle (aima: True)" (ac3 c))

; min-conflicts: random walk, so only validity is checked
(define c (aus))
(define r (min-conflicts c 1000 (make-rng 1)))
(check-true "min-conflicts aus seed 1 solves" (and r (csp-goal? c r)))
(define c (aus))
(define r (min-conflicts c 1000 (make-rng 42)))
(check-true "min-conflicts aus seed 42 solves" (and r (csp-goal? c r)))
(define c (make-nqueens-csp 8))
(define r (min-conflicts c 2000 (make-rng 1)))
(check-true "min-conflicts 8-queens seed 1 solves" (and r (csp-goal? c r)))
(define c (make-nqueens-csp 8))
(define r (min-conflicts c 2000 (make-rng 42)))
(check-true "min-conflicts 8-queens seed 42 solves" (and r (csp-goal? c r)))
(define c (make-nqueens-csp 20))
(define r (min-conflicts c 2000 (make-rng 1)))
(check-true "min-conflicts 20-queens seed 1 solves" (and r (csp-goal? c r)))
(define c (make-nqueens-csp 20))
(define r (min-conflicts c 2000 (make-rng 42)))
(check-true "min-conflicts 20-queens seed 42 solves" (and r (csp-goal? c r)))
