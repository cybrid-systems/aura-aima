;; Ch6 CSP: backtracking (first/MRV x unordered/LCV x none/forward checking) on
;; Australia map colouring and n-queens; solutions + nassigns/nchecks equal
;; aima-python (tests/oracle/csp_oracle.out, MRV ties = first minimum).
;; Expected lists are built with (list ...) — quoted data is unsafe (#4487, #4490).
(require "aima/check" all:)
(require "aima/csp" all:)
(require "aima/list" all:)
(require "problems/map-coloring" all:)

(define (mk name) (cond ((equal? name "aus") (make-map-coloring-csp (list (quote R) (quote G) (quote B)) australia-spec))
                        ((equal? name "q8") (make-nqueens-csp 8)) ((equal? name "q4") (make-nqueens-csp 4)) (else (make-nqueens-csp 3))))
(define (run prob name sel ord inf sol na nc)
  (let* ((c (mk prob)) (r (backtracking-search c sel ord inf)))
    (check-equal (string-append name " solution") (if r (assignment->list r) #f) sol)
    (if r (check-true (string-append name " goal") (csp-goal? c r)) #t)
    (check-equal (string-append name " nassigns/nchecks") (list (csp-nassigns c) (csp-nchecks c)) (list na nc))))
(define c0 (mk "aus"))
(check-equal "aus regions (T dropped, as aima-python)" (vector->list (csp-names c0)) (list (quote SA) (quote WA) (quote NT) (quote Q) (quote NSW) (quote V)))
(run "aus" "aus first unordered none" first-unassigned-variable unordered-domain-values no-inference (list (quote R) (quote G) (quote B) (quote G) (quote B) (quote G)) 6 40)
(run "aus" "aus first unordered fc" first-unassigned-variable unordered-domain-values forward-checking (list (quote R) (quote G) (quote B) (quote G) (quote B) (quote G)) 6 50)
(run "aus" "aus first lcv none" first-unassigned-variable lcv no-inference (list (quote R) (quote G) (quote B) (quote G) (quote B) (quote G)) 6 121)
(run "aus" "aus first lcv fc" first-unassigned-variable lcv forward-checking (list (quote R) (quote G) (quote B) (quote G) (quote B) (quote G)) 6 110)
(run "aus" "aus mrv unordered none" mrv unordered-domain-values no-inference (list (quote R) (quote G) (quote B) (quote G) (quote B) (quote G)) 6 40)
(run "aus" "aus mrv unordered fc" mrv unordered-domain-values forward-checking (list (quote R) (quote G) (quote B) (quote G) (quote B) (quote G)) 6 50)
(run "aus" "aus mrv lcv none" mrv lcv no-inference (list (quote R) (quote G) (quote B) (quote G) (quote B) (quote G)) 6 121)
(run "aus" "aus mrv lcv fc" mrv lcv forward-checking (list (quote R) (quote G) (quote B) (quote G) (quote B) (quote G)) 6 110)
(run "q8" "q8 first unordered none" first-unassigned-variable unordered-domain-values no-inference (list 0 4 7 5 2 6 1 3) 116 0)
(run "q8" "q8 first unordered fc" first-unassigned-variable unordered-domain-values forward-checking (list 0 4 7 5 2 6 1 3) 89 807)
(run "q8" "q8 first lcv none" first-unassigned-variable lcv no-inference (list 0 4 7 5 2 6 1 3) 128 26176)
(run "q8" "q8 first lcv fc" first-unassigned-variable lcv forward-checking (list 0 4 7 5 2 6 1 3) 104 5268)
(run "q8" "q8 mrv unordered none" mrv unordered-domain-values no-inference (list 0 4 7 5 2 6 1 3) 116 0)
(run "q8" "q8 mrv unordered fc" mrv unordered-domain-values forward-checking (list 0 4 7 5 2 6 1 3) 75 777)
(run "q8" "q8 mrv lcv none" mrv lcv no-inference (list 0 4 7 5 2 6 1 3) 128 26176)
(run "q8" "q8 mrv lcv fc" mrv lcv forward-checking (list 0 4 7 5 2 6 1 3) 89 4675)
(run "q4" "q4 first unordered none" first-unassigned-variable unordered-domain-values no-inference (list 1 3 0 2) 8 0)
(run "q4" "q4 first unordered fc" first-unassigned-variable unordered-domain-values forward-checking (list 1 3 0 2) 8 38)
(run "q4" "q4 first lcv none" first-unassigned-variable lcv no-inference (list 1 3 0 2) 8 288)
(run "q4" "q4 first lcv fc" first-unassigned-variable lcv forward-checking (list 1 3 0 2) 8 158)
(run "q4" "q4 mrv unordered none" mrv unordered-domain-values no-inference (list 1 3 0 2) 8 0)
(run "q4" "q4 mrv unordered fc" mrv unordered-domain-values forward-checking (list 1 3 0 2) 8 38)
(run "q4" "q4 mrv lcv none" mrv lcv no-inference (list 1 3 0 2) 8 288)
(run "q4" "q4 mrv lcv fc" mrv lcv forward-checking (list 1 3 0 2) 8 158)
(run "q3" "q3 first unordered none" first-unassigned-variable unordered-domain-values no-inference #f 5 0)
(run "q3" "q3 first unordered fc" first-unassigned-variable unordered-domain-values forward-checking #f 5 17)
(run "q3" "q3 first lcv none" first-unassigned-variable lcv no-inference #f 5 99)
(run "q3" "q3 first lcv fc" first-unassigned-variable lcv forward-checking #f 5 56)
(run "q3" "q3 mrv unordered none" mrv unordered-domain-values no-inference #f 5 0)
(run "q3" "q3 mrv unordered fc" mrv unordered-domain-values forward-checking #f 5 17)
(run "q3" "q3 mrv lcv none" mrv lcv no-inference #f 5 99)
(run "q3" "q3 mrv lcv fc" mrv lcv forward-checking #f 5 56)
